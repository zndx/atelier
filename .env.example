# Atelier local overrides — copy to .env and uncomment as needed.
# devenv shell loads .env automatically (dotenv.enable = true in devenv.nix).

# ANTHROPIC_API_KEY=sk-ant-...
# ATELIER_GRPC_PORT=50051
# ATELIER_AGENT_MODEL=claude-sonnet-4-5-20250929

# Database (devenv default: postgresql+psycopg://localhost:5533/atelier)
# ATELIER_DB_URL=postgresql+psycopg://localhost:5533/atelier

# Qdrant (devenv default: localhost:6333/6334)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
