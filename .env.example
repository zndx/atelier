# Atelier local overrides — copy to .env and uncomment as needed.
# devenv shell loads .env automatically (dotenv.enable = true in devenv.nix).
#
# Both Anthropic and Bedrock credentials can coexist. Set whichever
# apply — workloads pick the right provider based on model format.

# ── Anthropic direct API ────────────────────────────────────────
# Primary for local dev and BDD tests. Also serves as overwatch
# capability in production (onboarding, config assistance).
# ANTHROPIC_API_KEY=sk-ant-...

# ── Corporate gateway (token auth) ──────────────────────────────
# Alternative to ANTHROPIC_API_KEY: bearer-token auth against an
# internal Anthropic-compatible gateway (VPN). Gateways typically
# host Bedrock-style model IDs — pin the agent + sub-model knobs to
# IDs the gateway serves.
# ANTHROPIC_AUTH_TOKEN=...
# ANTHROPIC_BASE_URL=https://ai-gateway.example.com
# ATELIER_AGENT_MODEL=anthropic.claude-sonnet-4-6
# ANTHROPIC_DEFAULT_SONNET_MODEL=anthropic.claude-sonnet-4-6
# ANTHROPIC_DEFAULT_HAIKU_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# CLAUDE_CODE_SUBAGENT_MODEL=anthropic.claude-sonnet-4-6
# CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1
# ENABLE_TOOL_SEARCH=false

# ── AWS Bedrock ─────────────────────────────────────────────────
# Production default in CAI. Set model to an inference profile ARN.
# ATELIER_AGENT_MODEL=arn:aws:bedrock:us-east-1:440464140575:inference-profile/us.anthropic.claude-opus-4-6-v1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=...  (optional, for temporary credentials)

# ── Local LLM via llama.cpp (self-hosted, no credentials) ───────
#
# DEFAULT-ON for devenv: llama.cpp serves Nemotron and the classify
# backend points at it automatically when no external LLM is
# configured.  These knobs are OVERRIDES, not prerequisites.
# Disable the local stack with ATELIER_LLAMA_AUTOSTART=0.
# Turn-key: uncomment these three and `devenv up -d` serves NVIDIA
# Nemotron 3 Nano (Unsloth Q4_K_M quant, auto-downloaded + cached,
# ~18 GB first run) and points the classify sweep at it. No API key
# needed — the openai_compatible backend handles key-less servers.
# ATELIER_LLAMA_AUTOSTART=1
# ATELIER_LLM_BASE_URL=http://localhost:8080/v1
# ATELIER_LLM_MODEL=local
#
# Optional overrides:
# ATELIER_LLAMA_MODEL=~/models/some-model.gguf   # serve a local file instead
# ATELIER_LLAMA_HF=unsloth/Nemotron-3-Nano-30B-A3B-GGUF:Q4_K_M
# ATELIER_LLAMA_PORT=8080
# ATELIER_SDG_COLLECTION=research-project        # which sdg-corpora bundle to seed

# ── Federation surfaces (waffle) ────────────────────────────────
# Advertise a hostname UI, never 127.0.0.1. The waffle rebases to the
# browser Host when you opened the page by LAN IP.
# ATELIER_ADVERTISE_HOST=tinybox.dev.vista.zndx.org
# ATELIER_PRIMARY_UI=http://tinybox.dev.vista.zndx.org:3000
# ATELIER_UI_BIND=0.0.0.0:3000
# SIGNALS_ENGINE_TARGET=tinybox.dev.vista.zndx.org:50551

# ── Database ────────────────────────────────────────────────────
# devenv default: postgresql+psycopg://localhost:5533/atelier
# On CAI, PGlite starts automatically if ATELIER_DB_URL is unset.
# ATELIER_DB_URL=postgresql+psycopg://localhost:5533/atelier

# ── Qdrant ──────────────────────────────────────────────────────
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
