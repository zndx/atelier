# Optional credentials for the Atelier docker test stack.
# Copy to docker/.env (gitignored) and fill in what you need.
#
# The stack BOOTS without any of these — health, navigation, Status,
# Settings, and the embedding atlas all work. You only need credentials
# to START A CLASSIFICATION RUN or use the agent terminal.

# ── Anthropic direct API (simplest) ─────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# Model the agent/overwatch use (defaults to the config's Opus).
# ATELIER_AGENT_MODEL=claude-opus-4-7

# LLM used by the classification sweep. Set to enable POST /api/fsm/start.
# ATELIER_CLASSIFY_MODEL=claude-opus-4-7

# ── AWS Bedrock (alternative provider) ──────────────────────────────
# ATELIER_AGENT_MODEL=arn:aws:bedrock:us-east-1:...:inference-profile/us.anthropic.claude-opus-4-...
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=...
